# Copy this file to .env for local development.
# Never commit the real token.

# Base URL of the Django REST API (without a trailing slash).
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Token printed by `python manage.py seed_quiz --show-tokens` in the backend.
# Use the human token: it is the one allowed to delete resources.
VITE_API_TOKEN=replace-with-the-token-from-seed-quiz

# Optional: title shown in the cinema header.
VITE_APP_TITLE=Cartelera de Cine
